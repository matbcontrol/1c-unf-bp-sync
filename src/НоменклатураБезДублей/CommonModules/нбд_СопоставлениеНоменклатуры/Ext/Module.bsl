// Сопоставление номенклатуры при загрузке из УНФ в БП 3.0 через EnterpriseData.
//
// Типовые правила формата 1.6 ищут товар по полному наименованию, артикулу или наименованию
// только внутри той же группы и сравнивают строки буква в букву. Код из УНФ переносится как есть.
// Поэтому при первой синхронизации товар, который бухгалтер завёл в БП сам, задваивается,
// а если код из УНФ в БП уже занят, в справочнике появляются два товара с одним кодом.
//
// Расширение ищет товар по всему справочнику, когда типовой поиск ничего не нашёл:
// сначала по артикулу, затем по наименованию без учёта регистра, кавычек, знаков препинания,
// пробелов и латинских букв, похожих на русские. Если подходят несколько товаров, не выбирает
// ни один и пишет предупреждение в журнал регистрации. Код из УНФ товар получает, только если
// в БП этот код свободен.

#Область ПрограммныйИнтерфейс

// Подбирает товар БП для товара из сообщения и запоминает результат в его дополнительных свойствах.
// Вызывается после типового обработчика ПриКонвертацииДанныхXDTO, до поиска по полям.
//
// Параметры:
//  ПолученныеДанные - СправочникОбъект.Номенклатура - товар, собранный из сообщения обмена.
//  КомпонентыОбмена - Структура - компоненты обмена БСП, в них живёт индекс номенклатуры на время загрузки.
//
Процедура ПодобратьТовар(ПолученныеДанные, КомпонентыОбмена) Экспорт

	Если ПолученныеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	Индекс = ИндексНоменклатуры(КомпонентыОбмена);
	Подбор = НайтиВИндексе(Индекс, ПолученныеДанные.Артикул,
		ПолученныеДанные.Наименование, ПолученныеДанные.НаименованиеПолное);
	Подбор.Вставить("Индекс", Индекс);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("нбд_Подбор", Подбор);

КонецПроцедуры

// Возвращает подобранный товар БП. Вызывается, только когда типовой поиск по полям ничего не нашёл.
//
// Параметры:
//  ПолученныеДанные - СправочникОбъект.Номенклатура - товар, собранный из сообщения обмена.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура, Неопределено - товар БП, с которым надо связать товар из УНФ.
//
Функция ПодобранныйТовар(ПолученныеДанные) Экспорт

	Подбор = Неопределено;
	Если Не ПолученныеДанные.ДополнительныеСвойства.Свойство("нбд_Подбор", Подбор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Подбор.Кандидатов > 1 Тогда
		ПредупредитьОднажды(Подбор.Индекс, Неопределено,
			СтрШаблон(НСтр("ru = 'Товар «%1» из УНФ подходит %2 к нескольким товарам БП (%3), создан новый. Сопоставьте вручную.'"),
				ПолученныеДанные.Наименование, Подбор.Способ, Подбор.Кандидатов));
		Возврат Неопределено;
	КонецЕсли;

	Если Подбор.Товар = Неопределено
		Или Подбор.Индекс.Занятые[Подбор.Товар] <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Один товар БП не связываем с двумя товарами из одного сообщения.
	Подбор.Индекс.Занятые.Вставить(Подбор.Товар, Истина);
	ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация, Подбор.Товар,
		СтрШаблон(НСтр("ru = 'Товар «%1» из УНФ сопоставлен %2 с товаром БП «%3».'"),
			ПолученныеДанные.Наименование, Подбор.Способ, Подбор.Товар));
	Возврат Подбор.Товар;

КонецФункции

// Не даёт товару из УНФ занять код, который в БП уже у другого элемента справочника.
// Новый товар получит следующий код БП, найденный товар сохранит свой код.
// Вызывается после типового обработчика ПередЗаписьюПолученныхДанных.
//
// Параметры:
//  ПолученныеДанные - СправочникОбъект.Номенклатура - товар из сообщения обмена.
//  ДанныеИБ - СправочникОбъект.Номенклатура, Неопределено - найденный товар БП, для нового товара Неопределено.
//
Процедура НеЗаниматьЧужойКод(ПолученныеДанные, ДанныеИБ) Экспорт

	Код = СокрЛП(ПолученныеДанные.Код);
	Если ПолученныеДанные.ЭтоГруппа Или ПустаяСтрока(Код) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Код = &Код
	|	И Номенклатура.Ссылка <> &Товар");
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("Товар", ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	// Новый товар предупреждает один раз. У связанного товара код остаётся прежним при каждой синхронизации,
	// это обычное состояние, поэтому запись информационная.
	Если ДанныеИБ = Неопределено Тогда
		// Пустой код типовая загрузка заменит новым кодом БП перед записью.
		ПолученныеДанные.Код = "";
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
		Решение = НСтр("ru = 'товар получит новый код БП'");
	Иначе
		ПолученныеДанные.Код = ДанныеИБ.Код;
		Уровень = УровеньЖурналаРегистрации.Информация;
		Решение = СтрШаблон(НСтр("ru = 'товару БП оставлен код %1'"), ДанныеИБ.Код);
	КонецЕсли;
	ЗаписатьВЖурнал(Уровень, Выборка.Ссылка,
		СтрШаблон(НСтр("ru = 'Код %1 товара «%2» из УНФ в БП уже занят товаром «%3», %4.'"),
			Код, ПолученныеДанные.Наименование, Выборка.Ссылка, Решение));

КонецПроцедуры

// Ключ наименования для сравнения: только буквы и цифры в нижнем регистре,
// латинские буквы, похожие на русские, заменены русскими, «ё» заменена на «е».
//
// Параметры:
//  Текст - Строка - наименование товара.
//
// Возвращаемое значение:
//  Строка - например, «губкидляпосудыкухоньчик3штупак» для «Губки для посуды "КУХОНЬЧИК" 3 шт/упак.».
//
Функция КлючНаименования(Знач Текст) Экспорт

	Текст = РусскиеВместоПохожихЛатинских(НРег(Текст));
	Буквы = Новый Массив;
	Для Номер = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Номер, 1);
		// После НРег у буквы верхний регистр отличается от неё самой, у знаков и пробелов совпадает.
		Если ВРег(Символ) <> Символ Или СтрНайти("0123456789", Символ) > 0 Тогда
			Буквы.Добавить(Символ);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Буквы);

КонецФункции

// Ключ артикула для сравнения: без пробелов, в нижнем регистре, латинские двойники заменены русскими.
// Дефисы и точки остаются: «12-34» и «1234» считаются разными артикулами.
//
// Параметры:
//  Артикул - Строка - артикул товара.
//
// Возвращаемое значение:
//  Строка - ключ артикула, пустая строка для пустого артикула.
//
Функция КлючАртикула(Знач Артикул) Экспорт

	Возврат СтрЗаменить(РусскиеВместоПохожихЛатинских(НРег(СокрЛП(Артикул))), " ", "");

КонецФункции

// Имя события в журнале регистрации, под которым расширение пишет сопоставления и предупреждения.
//
// Возвращаемое значение:
//  Строка - имя события.
//
Функция ИмяСобытияЖурнала() Экспорт

	Возврат "Обмен данными.Номенклатура без дублей";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Индекс строится один раз за загрузку: артикулы и ключи наименований всех действующих товаров БП.
Функция ИндексНоменклатуры(КомпонентыОбмена)

	Индекс = Неопределено;
	Если КомпонентыОбмена.Свойство("нбд_ИндексНоменклатуры", Индекс) Тогда
		Возврат Индекс;
	КонецЕсли;

	Индекс = Новый Структура;
	Индекс.Вставить("ПоАртикулу", Новый Соответствие);
	Индекс.Вставить("ПоНаименованию", Новый Соответствие);
	Индекс.Вставить("Артикулы", Новый Соответствие);
	Индекс.Вставить("Наименования", Новый Соответствие);
	Индекс.Вставить("Занятые", Новый Соответствие);
	Индекс.Вставить("Предупреждения", Новый Соответствие);

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Артикул = КлючАртикула(Выборка.Артикул);
		Индекс.Артикулы.Вставить(Выборка.Ссылка, Артикул);
		Если Артикул <> "" Тогда
			ДобавитьВСписок(Индекс.ПоАртикулу, Артикул, Выборка.Ссылка);
		КонецЕсли;
		Ключи = КлючиНаименований(Выборка.Наименование, Выборка.НаименованиеПолное);
		Индекс.Наименования.Вставить(Выборка.Ссылка, Ключи);
		Для Каждого Ключ Из Ключи Цикл
			ДобавитьВСписок(Индекс.ПоНаименованию, Ключ, Выборка.Ссылка);
		КонецЦикла;
	КонецЦикла;

	// Товары, уже связанные с другими товарами УНФ, повторно не сопоставляются.
	Если ЗначениеЗаполнено(КомпонентыОбмена.УзелКорреспондента) Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Идентификаторы.Ссылка КАК Ссылка
		|ИЗ
		|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК Идентификаторы
		|ГДЕ
		|	Идентификаторы.УзелИнформационнойБазы = &Узел
		|	И Идентификаторы.Ссылка ССЫЛКА Справочник.Номенклатура");
		Запрос.УстановитьПараметр("Узел", КомпонентыОбмена.УзелКорреспондента);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Индекс.Занятые.Вставить(Выборка.Ссылка, Истина);
		КонецЦикла;
	КонецЕсли;

	КомпонентыОбмена.Вставить("нбд_ИндексНоменклатуры", Индекс);
	Возврат Индекс;

КонецФункции

// Сначала артикул, а если по артикулу в БП никого нет, наименование.
// Возвращает структуру: Товар (ссылка или Неопределено), Способ (для журнала), Кандидатов (сколько подошло).
Функция НайтиВИндексе(Индекс, Артикул, Наименование, НаименованиеПолное)

	Результат = Новый Структура("Товар, Способ, Кандидатов", Неопределено, "", 0);
	КлючАртикула = КлючАртикула(Артикул);
	КлючиИмени = КлючиНаименований(Наименование, НаименованиеПолное);

	Если КлючАртикула <> "" Тогда
		Кандидаты = Свободные(Индекс, Индекс.ПоАртикулу[КлючАртикула]);
		Результат.Способ = НСтр("ru = 'по артикулу'");
		Если Кандидаты.Количество() > 1 Тогда
			// Артикул в БП повторяется: из этих товаров берём тот, у которого то же наименование.
			СТемЖеИменем = Новый Массив;
			Для Каждого Товар Из Кандидаты Цикл
				Если Пересекаются(Индекс.Наименования[Товар], КлючиИмени) Тогда
					СТемЖеИменем.Добавить(Товар);
				КонецЕсли;
			КонецЦикла;
			Если СТемЖеИменем.Количество() = 1 Тогда
				Кандидаты = СТемЖеИменем;
				Результат.Способ = НСтр("ru = 'по артикулу и наименованию'");
			КонецЕсли;
		КонецЕсли;
		Если Кандидаты.Количество() > 0 Тогда
			Возврат ЗаполнитьИтог(Результат, Кандидаты);
		КонецЕсли;
	КонецЕсли;

	Кандидаты = Новый Массив;
	Для Каждого Ключ Из КлючиИмени Цикл
		Для Каждого Товар Из Свободные(Индекс, Индекс.ПоНаименованию[Ключ]) Цикл
			// Одинаковое наименование при разных артикулах: это разные товары, например размеры.
			АртикулБП = Индекс.Артикулы[Товар];
			Если КлючАртикула <> "" И АртикулБП <> "" И АртикулБП <> КлючАртикула Тогда
				Продолжить;
			КонецЕсли;
			Если Кандидаты.Найти(Товар) = Неопределено Тогда
				Кандидаты.Добавить(Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Результат.Способ = НСтр("ru = 'по наименованию'");
	Возврат ЗаполнитьИтог(Результат, Кандидаты);

КонецФункции

Функция ЗаполнитьИтог(Результат, Кандидаты)

	Результат.Кандидатов = Кандидаты.Количество();
	Если Кандидаты.Количество() = 1 Тогда
		Результат.Товар = Кандидаты[0];
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция КлючиНаименований(Наименование, НаименованиеПолное)

	Ключи = Новый Массив;
	Для Каждого Текст Из СтрРазделить(Наименование + Символы.ПС + НаименованиеПолное, Символы.ПС, Ложь) Цикл
		Ключ = КлючНаименования(Текст);
		Если Ключ <> "" И Ключи.Найти(Ключ) = Неопределено Тогда
			Ключи.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Ключи;

КонецФункции

// Латинские буквы, которые набирают вместо похожих русских: «100x600», «POBEDA».
// Первая строка латиница, вторая кириллица, буквы попарно выглядят одинаково.
Функция РусскиеВместоПохожихЛатинских(Знач Текст)

	Латинские = "abcehkmoptxy";
	Русские = "авсенкмортху";
	Для Номер = 1 По СтрДлина(Латинские) Цикл
		Текст = СтрЗаменить(Текст, Сред(Латинские, Номер, 1), Сред(Русские, Номер, 1));
	КонецЦикла;
	Возврат СтрЗаменить(Текст, "ё", "е");

КонецФункции

Функция Свободные(Индекс, Список)

	Результат = Новый Массив;
	Если Список = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Товар Из Список Цикл
		Если Индекс.Занятые[Товар] = Неопределено Тогда
			Результат.Добавить(Товар);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Пересекаются(Первый, Второй)

	Если Первый = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Элемент Из Первый Цикл
		Если Второй.Найти(Элемент) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ДобавитьВСписок(Соответствие, Ключ, Значение)

	Список = Соответствие[Ключ];
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Соответствие.Вставить(Ключ, Список);
	КонецЕсли;
	Если Список.Найти(Значение) = Неопределено Тогда
		Список.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

// Одно предупреждение на товар за загрузку: товар может встретиться в сообщении много раз, например в документах.
Процедура ПредупредитьОднажды(Индекс, Товар, Текст)

	Если Индекс.Предупреждения[Текст] = Неопределено Тогда
		Индекс.Предупреждения.Вставить(Текст, Истина);
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Предупреждение, Товар, Текст);
	КонецЕсли;

