#Область Помощники

Процедура Сценарий(Название, ИмяТеста)

	Раздел(Название);
	НачалоСценария = ТекущаяДатаСеанса();
	НачатьТранзакцию();
	Попытка
		Выполнить(ИмяТеста + "()");
	Исключение
		Провалено = Провалено + 1;
		Строки.Добавить("  FAIL  сценарий упал: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Пока ТранзакцияАктивна() Цикл
		ОтменитьТранзакцию();
	КонецЦикла;

КонецПроцедуры

Функция ЗавестиТовар(Наименование, Артикул = "", Код = "", ПометкаУдаления = Ложь)

	Элемент = Справочники.Номенклатура.СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.НаименованиеПолное = Наименование;
	Элемент.Артикул = Артикул;
	Элемент.ЕдиницаИзмерения = Шт;
	Если ЗначениеЗаполнено(Код) Тогда
		Элемент.Код = Код;
	Иначе
		Элемент.УстановитьНовыйКод();
	КонецЕсли;
	Элемент.ПометкаУдаления = ПометкаУдаления;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

Процедура Загрузить()

	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ФайлСообщения);
	Результат = Обработки.ВыгрузкаЗагрузкаEnterpriseData.Создать().ЗагрузитьДанныеИзXML(Чтение);
	Чтение.Закрыть();
	Если Результат.ЕстьОшибки Тогда
		ВызватьИсключение "загрузка с ошибками: " + Результат.ТекстОшибки;
	КонецЕсли;

КонецПроцедуры

Функция ЧислоТоваров(Поле = "", Значение = Неопределено)

	Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ Справочник.Номенклатура КАК Т ГДЕ НЕ Т.ЭтоГруппа";
	Если Поле <> "" Тогда
		Текст = Текст + " И Т." + Поле + " = &Значение";
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Значение", Значение);
	Возврат Запрос.Выполнить().Выгрузить()[0].Число;

КонецФункции

Функция ПовторяющихсяКодов()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Число
	|ИЗ
	|	(ВЫБРАТЬ
	|		Т.Код КАК Код
	|	ИЗ
	|		Справочник.Номенклатура КАК Т
	|	СГРУППИРОВАТЬ ПО
	|		Т.Код
	|	ИМЕЮЩИЕ
	|		КОЛИЧЕСТВО(*) > 1) КАК Повторы");
	Возврат Запрос.Выполнить().Выгрузить()[0].Число;

КонецФункции

Функция ТоварПоАртикулу(Артикул)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник.Номенклатура КАК Т ГДЕ Т.Артикул = &Артикул");
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Реквизиты читаются запросом, чтобы видеть данные после загрузки, а не закэшированные по ссылке.
Функция Реквизиты(Ссылка)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Наименование КАК Наименование,
	|	Т.Код КАК Код,
	|	Т.Артикул КАК Артикул,
	|	Т.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.Номенклатура КАК Т
	|ГДЕ
	|	Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Структура("Наименование, Код, Артикул, ПометкаУдаления", "", "", "", Неопределено);
	Если Выборка.Следующий() Тогда
		Результат.Наименование = СокрЛП(Выборка.Наименование);
		Результат.Код = СокрЛП(Выборка.Код);
		Результат.Артикул = СокрЛП(Выборка.Артикул);
		Результат.ПометкаУдаления = Выборка.ПометкаУдаления;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЕстьВЖурнале(Подстрока)

	Журнал = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Журнал,
		Новый Структура("Событие, НачалоПериода", "Обмен данными.Номенклатура без дублей", НачалоСценария));
	Для Каждого Запись Из Журнал Цикл
		Если СтрНайти(Запись.Комментарий, Подстрока) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция БезопасныйРежимРасширения()

	Найденные = РасширенияКонфигурации.Получить(Новый Структура("Имя", "НоменклатураБезДублей"));
	Возврат Найденные.Количество() = 0 Или Найденные[0].БезопасныйРежим <> Ложь;

КонецФункции

