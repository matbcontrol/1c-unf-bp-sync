// Автотесты расширения «Номенклатура из УНФ без дублей» на учебной БП 3.0.
//
// tools/test.ps1 прогоняет их дважды на копии базы, восстановленной из эталона: сначала без расширения,
// чтобы было видно, где типовые правила задваивают товары, затем с расширением из build.
// 1cv8.exe ENTERPRISE /F <база БП> /Execute ТестыСопоставления.epf /C "Тесты;<каталог проекта>;<отчёт.txt>"
//
// Каждый сценарий идёт в транзакции, которая в конце отменяется. Сценарий заводит товары в БП, загружает
// tests/fixtures/ed_unf_items.xml типовой обработкой «Выгрузка и загрузка EnterpriseData» и смотрит,
// что стало со справочником. Сообщение выгружено из демобазы УНФ 3.0 в формате EnterpriseData 1.6:
//   Совок для мусора пластмассовый ("POBEDA"), арт. 3545, код ФР-00000192
//   Губки для посуды "КУХОНЬЧИК" 3 шт/упак., арт. 9689, код ФР-00000210
//   Мебельная деталь 100х600 (русская «х»), арт. 201, код ФР-00000009
//   Корзина для хранения "ВЕЛЕТТА", 25*14*7 см, арт. 8900, код ФР-00000123
// и пять групп этих товаров.

Перем Строки;
Перем Пройдено;
Перем Провалено;
Перем ФайлОтчета;
Перем НачалоПрогона;
Перем НачалоРаздела;
Перем НачалоСценария;
Перем ФайлСообщения;
Перем СРасширением;
Перем Шт;

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ВыполнитьВсе(Каталог, ПутьКОтчетуТестов) Экспорт

	Строки = Новый Массив;
	Пройдено = 0;
	Провалено = 0;
	ФайлОтчета = ПутьКОтчетуТестов;
	НачалоПрогона = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ФайлСообщения = Каталог + "\tests\fixtures\ed_unf_items.xml";
	СРасширением = Метаданные.ОбщиеМодули.Найти("нбд_СопоставлениеНоменклатуры") <> Неопределено;
	Шт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");

	Строки.Добавить(?(СРасширением,
		"С расширением «Номенклатура из УНФ без дублей».",
		"Без расширения: типовые правила обмена БП 3.0.67, EnterpriseData 1.6."));

	Попытка
		Если СРасширением Тогда
			Раздел("Расширение подключено");
			ПроверитьИстина("расширение работает не в безопасном режиме", Не БезопасныйРежимРасширения(),
				"включён безопасный режим, платформа не даст перехватить модули обмена");
			Раздел("Ключи сравнения наименований и артикулов");
			ТестКлючей();
		КонецЕсли;
		Сценарий("Артикул тот же, наименование и группа другие", "ТестАртикула");
		Сценарий("Наименование отличается кавычками, точкой и регистром", "ТестНаименования");
		Сценарий("Латинская x вместо русской х в размере", "ТестЛатиницы");
		Сценарий("Код из УНФ в БП уже занят другим товаром", "ТестКода");
		Сценарий("Артикул в БП у двух товаров", "ТестНеоднозначности");
		Сценарий("Артикул у двух товаров, наименование у одного", "ТестУточнения");
		Сценарий("Наименование то же, артикулы разные", "ТестРазныхАртикулов");
		Сценарий("Товар БП помечен на удаление", "ТестПометкиУдаления");
		Сценарий("Повторная загрузка того же сообщения", "ТестПовтора");
		Сценарий("Объём: 1 900 товаров в БП", "ТестОбъема");
	Исключение
		Провалено = Провалено + 1;
		Строки.Добавить("СБОЙ ТЕСТОВ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗакрытьРаздел();
	СохранитьОтчет(Истина);
	Возврат Провалено = 0;

КонецФункции

// Снимает безопасный режим с установленного расширения. Действует со следующего сеанса.
Процедура СнятьБезопасныйРежим(ПутьКОтчету) Экспорт

	Текст = Новый ТекстовыйДокумент;
	Найденные = РасширенияКонфигурации.Получить(Новый Структура("Имя", "НоменклатураБезДублей"));
	Если Найденные.Количество() = 0 Тогда
		Текст.УстановитьТекст("расширение НоменклатураБезДублей не установлено");
	Иначе
		Найденные[0].БезопасныйРежим = Ложь;
		Найденные[0].Записать();
		Текст.УстановитьТекст("безопасный режим снят");
	КонецЕсли;
	Текст.Записать(ПутьКОтчету, КодировкаТекста.UTF8);

КонецПроцедуры

// Для снимков в README: заводит товары бухгалтера, загружает сообщение из УНФ без транзакции и отката
// и возвращает таблицу с товарами, которые появились или изменились. Повторы кодов и артикулов красные.
Функция ПодготовитьПоказ(Каталог) Экспорт

	ФайлСообщения = Каталог + "\tests\fixtures\ed_unf_items.xml";
	Шт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	СРасширением = Метаданные.ОбщиеМодули.Найти("нбд_СопоставлениеНоменклатуры") <> Неопределено;
	Исходные = СнимокНоменклатуры();
	ЗавестиТовар("Совок пластиковый POBEDA", "3545");
	ЗавестиТовар("Губки для посуды КУХОНЬЧИК 3 шт/упак");
	ЗавестиТовар("мебельная деталь 100x600");
	ЗавестиТовар("Бумага офисная А4", "А4-500", "ФР-00000123");
	До = СнимокНоменклатуры();
	Загрузить();
	После = СнимокНоменклатуры();

	Кодов = Новый Соответствие;
	Артикулов = Новый Соответствие;
	Для Каждого Строка Из После Цикл
		Кодов.Вставить(Строка.Код, ?(Кодов[Строка.Код] = Неопределено, 0, Кодов[Строка.Код]) + 1);
		Если Строка.Артикул <> "" Тогда
			Артикулов.Вставить(Строка.Артикул, ?(Артикулов[Строка.Артикул] = Неопределено, 0, Артикулов[Строка.Артикул]) + 1);
		КонецЕсли;
	КонецЦикла;

	Документ = Новый ТабличныйДокумент;
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Красный = Новый Цвет(192, 0, 0);
	Ячейка(Документ, 1, 1, ?(СРасширением,
		"С расширением «Номенклатура из УНФ без дублей»",
		"Без расширения: типовые правила обмена БП 3.0"), Новый Шрифт(, 13, Истина));
	Ячейка(Документ, 2, 1, "Бухгалтер завёл четыре товара, затем из УНФ загружено сообщение с четырьмя товарами.");
	Номер = 4;
	Заголовки = СтрРазделить("Код,Наименование,Артикул,Как товар появился в справочнике", ",");
	Для Колонка = 1 По 4 Цикл
		Область = Ячейка(Документ, Номер, Колонка, Заголовки[Колонка - 1], Новый Шрифт(, , Истина));
		Область.ЦветФона = Новый Цвет(242, 242, 242);
		Область.Обвести(Линия, Линия, Линия, Линия);
	КонецЦикла;

	Новых = 0;
	Для Каждого Строка Из После Цикл
		Если Исходные.Найти(Строка.Ссылка, "Ссылка") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Было = До.Найти(Строка.Ссылка, "Ссылка");
		Если Было = Неопределено Тогда
			Откуда = "создан загрузкой из УНФ";
			Новых = Новых + 1;
		ИначеЕсли Было.Наименование <> Строка.Наименование Или Было.Артикул <> Строка.Артикул Тогда
			Откуда = "завёл бухгалтер как «" + Было.Наименование + "», связан с товаром из УНФ";
		Иначе
			Откуда = "завёл бухгалтер";
		КонецЕсли;
		Номер = Номер + 1;
		Значения = Новый Массив;
		Значения.Добавить(Строка.Код);
		Значения.Добавить(Строка.Наименование);
		Значения.Добавить(Строка.Артикул);
		Значения.Добавить(Откуда);
		Для Колонка = 1 По 4 Цикл
			Область = Ячейка(Документ, Номер, Колонка, Значения[Колонка - 1]);
			Область.Обвести(Линия, Линия, Линия, Линия);
		КонецЦикла;
		Если Кодов[Строка.Код] > 1 Тогда
			Документ.Область(Номер, 1, Номер, 1).ЦветТекста = Красный;
		КонецЕсли;
		Если Строка.Артикул <> "" И Артикулов[Строка.Артикул] > 1 Тогда
			Документ.Область(Номер, 3, Номер, 3).ЦветТекста = Красный;
		КонецЕсли;
	КонецЦикла;

	Повторов = 0;
	Для Каждого КлючИЗначение Из Кодов Цикл
		Повторов = Повторов + ?(КлючИЗначение.Значение > 1, 1, 0);
	КонецЦикла;
	Ячейка(Документ, Номер + 2, 1, СтрШаблон("Новых товаров после загрузки: %1. Кодов, которые носят два товара: %2.", Новых, Повторов),
		Новый Шрифт(, , Истина));
	Ширины = СтрРазделить("13,44,9,74", ",");
	Для Колонка = 1 По 4 Цикл
		Документ.Область(, Колонка, , Колонка).ШиринаКолонки = Число(Ширины[Колонка - 1]);
	КонецЦикла;
	// Рамка текущей ячейки уходит правее таблицы, чтобы не закрывать заголовок на снимке.
	Документ.ТекущаяОбласть = Документ.Область(1, 6, 1, 6);
	Документ.ТолькоПросмотр = Истина;
	Документ.ОтображатьСетку = Ложь;
	Документ.ОтображатьЗаголовки = Ложь;
	Возврат Документ;

КонецФункции

Функция Ячейка(Документ, НомерСтроки, НомерКолонки, Текст, Шрифт = Неопределено)

	Область = Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Область.Текст = Текст;
	Если Шрифт <> Неопределено Тогда
		Область.Шрифт = Шрифт;
	КонецЕсли;
	Возврат Область;

КонецФункции

Функция СнимокНоменклатуры()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Код КАК Код,
	|	Т.Наименование КАК Наименование,
	|	Т.Артикул КАК Артикул
	|ИЗ
	|	Справочник.Номенклатура КАК Т
	|ГДЕ
	|	НЕ Т.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование");
	Таблица = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из Таблица Цикл
		Строка.Код = СокрЛП(Строка.Код);
		Строка.Наименование = СокрЛП(Строка.Наименование);
		Строка.Артикул = СокрЛП(Строка.Артикул);
	КонецЦикла;
	Возврат Таблица;

КонецФункции

#Область Сценарии

Процедура ТестАртикула()

	Товар = ЗавестиТовар("Совок пластиковый POBEDA", "3545");
	Было = ЧислоТоваров();
	Загрузить();
	Если СРасширением Тогда
		Проверить("товаров с артикулом 3545", ЧислоТоваров("Артикул", "3545"), 1);
		Проверить("товар БП получил наименование совка из УНФ", Реквизиты(Товар).Наименование,
			"Совок для мусора пластмассовый (""POBEDA"")");
		Проверить("и код из УНФ, в БП он свободен", Реквизиты(Товар).Код, "ФР-00000192");
		Проверить("новых товаров: губки, деталь, корзина", ЧислоТоваров() - Было, 3);
		ПроверитьИстина("в журнале запись о сопоставлении по артикулу", ЕстьВЖурнале("сопоставлен по артикулу"), "записи нет");
	Иначе
		Проверить("товаров с артикулом 3545: типовая загрузка завела совок вторым товаром", ЧислоТоваров("Артикул", "3545"), 2);
		Проверить("новых товаров: все четыре", ЧислоТоваров() - Было, 4);
	КонецЕсли;

КонецПроцедуры

Процедура ТестНаименования()

	Товар = ЗавестиТовар("Губки для посуды КУХОНЬЧИК 3 шт/упак");
	Было = ЧислоТоваров();
	Загрузить();
	Если СРасширением Тогда
		Проверить("губки из УНФ связаны с товаром БП, он получил артикул 9689", Реквизиты(Товар).Артикул, "9689");
		Проверить("новых товаров", ЧислоТоваров() - Было, 3);
	Иначе
		Проверить("у товара БП артикула нет: типовая загрузка завела губки вторым товаром", Реквизиты(Товар).Артикул, "");
		Проверить("новых товаров", ЧислоТоваров() - Было, 4);
	КонецЕсли;

КонецПроцедуры

Процедура ТестЛатиницы()

	// В наименовании БП латинская «x», в УНФ русская «х».
	Товар = ЗавестиТовар("мебельная деталь 100x600");
	Было = ЧислоТоваров();
	Загрузить();
	Если СРасширением Тогда
		Проверить("деталь из УНФ связана с товаром БП, он получил артикул 201", Реквизиты(Товар).Артикул, "201");
		Проверить("новых товаров", ЧислоТоваров() - Было, 3);
	Иначе
		Проверить("у товара БП артикула нет: типовая загрузка завела деталь вторым товаром", Реквизиты(Товар).Артикул, "");
		Проверить("новых товаров", ЧислоТоваров() - Было, 4);
	КонецЕсли;

КонецПроцедуры

Процедура ТестКода()

	// Код корзины «ВЕЛЕТТА» в УНФ.
	Бумага = ЗавестиТовар("Бумага офисная А4", "А4-500", "ФР-00000123");
	Загрузить();
	Корзина = ТоварПоАртикулу("8900");
	Проверить("бумага не изменилась", Реквизиты(Бумага).Наименование, "Бумага офисная А4");
	Если СРасширением Тогда
		Проверить("товаров с кодом ФР-00000123", ЧислоТоваров("Код", "ФР-00000123"), 1);
		КодКорзины = Реквизиты(Корзина).Код;
		ПроверитьИстина("корзина получила новый код БП", КодКорзины <> "" И КодКорзины <> "ФР-00000123",
			"код корзины «" + КодКорзины + "»");
		ПроверитьИстина("в журнале предупреждение о занятом коде", ЕстьВЖурнале("уже занят товаром «Бумага офисная А4»"),
			"записи нет");
	Иначе
		Проверить("товаров с кодом ФР-00000123: типовая загрузка отдала код бумаги корзине", ЧислоТоваров("Код", "ФР-00000123"), 2);
	КонецЕсли;

КонецПроцедуры

Процедура ТестНеоднозначности()

	Большой = ЗавестиТовар("Совок большой", "3545");
	Малый = ЗавестиТовар("Совок малый", "3545");
	Загрузить();
	Проверить("товаров с артикулом 3545: оба товара БП и совок из УНФ", ЧислоТоваров("Артикул", "3545"), 3);
	Проверить("товары БП не тронуты", Реквизиты(Большой).Наименование + ", " + Реквизиты(Малый).Наименование,
		"Совок большой, Совок малый");
	Если СРасширением Тогда
		ПроверитьИстина("в журнале просьба сопоставить вручную", ЕстьВЖурнале("подходит по артикулу к нескольким товарам БП (2)"),
			"записи нет");
	КонецЕсли;

КонецПроцедуры

Процедура ТестУточнения()

	Совок = ЗавестиТовар("Совок для мусора пластмассовый POBEDA", "3545");
	Малый = ЗавестиТовар("Совок малый", "3545");
	Загрузить();
	Проверить("совок малый не тронут", Реквизиты(Малый).Наименование, "Совок малый");
	Если СРасширением Тогда
		Проверить("товаров с артикулом 3545", ЧислоТоваров("Артикул", "3545"), 2);
		Проверить("совок из УНФ связан с товаром БП с тем же наименованием", Реквизиты(Совок).Код, "ФР-00000192");
	Иначе
		Проверить("товаров с артикулом 3545: типовая загрузка завела третий", ЧислоТоваров("Артикул", "3545"), 3);
	КонецЕсли;

КонецПроцедуры

Процедура ТестРазныхАртикулов()

	// Наименование совпадает с губками из УНФ буква в букву, артикул другой: это другой товар.
	Товар = ЗавестиТовар("Губки для посуды ""КУХОНЬЧИК"" 3 шт/упак.", "1111");
	Загрузить();
	Проверить("товар БП с артикулом 1111 не тронут", Реквизиты(Товар).Артикул, "1111");
	Проверить("губки из УНФ заведены отдельным товаром", ЧислоТоваров("Артикул", "9689"), 1);

КонецПроцедуры

Процедура ТестПометкиУдаления()

	Товар = ЗавестиТовар("Совок пластиковый POBEDA", "3545", , Истина);
	Загрузить();
	Проверить("помеченный товар не подобран, совок из УНФ заведён новым", ЧислоТоваров("Артикул", "3545"), 2);
	Проверить("помеченный товар остался помеченным", Реквизиты(Товар).ПометкаУдаления, Истина);

КонецПроцедуры

Процедура ТестПовтора()

	ЗавестиТовар("Совок пластиковый POBEDA", "3545");
