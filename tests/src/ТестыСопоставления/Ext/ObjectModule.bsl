#Область Отчет

Процедура Раздел(Название)

	ЗакрытьРаздел();
	Строки.Добавить("");
	Строки.Добавить(Название);
	НачалоРаздела = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СохранитьОтчет(Ложь);

КонецПроцедуры

Процедура ЗакрытьРаздел()

	Если НачалоРаздела <> Неопределено Тогда
		Строки.Добавить("  (" + Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоРаздела) / 1000, "ЧДЦ=1; ЧН=0") + " с)");
		НачалоРаздела = Неопределено;
	КонецЕсли;

КонецПроцедуры

// Отчёт пишется после каждого раздела: если прогон прервётся, видно, где.
Процедура СохранитьОтчет(Итоговый)

	Заголовок = СтрШаблон("Проверок: %1, пройдено: %2, не пройдено: %3. Время: %4 с.%5",
		Пройдено + Провалено, Пройдено, Провалено,
		Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПрогона) / 1000, "ЧДЦ=1; ЧН=0"),
		?(Итоговый, "", " (прогон идёт)"));
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(Заголовок + Символы.ПС + СтрСоединить(Строки, Символы.ПС));
	Текст.Записать(ФайлОтчета, КодировкаТекста.UTF8);

КонецПроцедуры

Процедура Проверить(Название, Фактически, Ожидалось)

	Если Фактически = Ожидалось Тогда
		Пройдено = Пройдено + 1;
		Строки.Добавить("  ok    " + Название);
	Иначе
		Провалено = Провалено + 1;
		Строки.Добавить("  FAIL  " + Название + ": ожидалось «" + Ожидалось + "», получено «" + Фактически + "»");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИстина(Название, Условие, Подробности)

	Если Условие = Истина Тогда
		Пройдено = Пройдено + 1;
		Строки.Добавить("  ok    " + Название);
	Иначе
		Провалено = Провалено + 1;
		Строки.Добавить("  FAIL  " + Название + ": " + Подробности);
	КонецЕсли;

КонецПроцедуры

