// Запуск тестов: /Execute ТестыСопоставления.epf /C "Тесты;<каталог проекта>;<отчёт.txt>"
// После установки расширения: /C "СнятьБезопасныйРежим;<отчёт.txt>". В безопасном режиме платформа
// не даёт расширению перехватывать модули обмена, новое значение действует со следующего сеанса.
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Части = СтрРазделить(ПараметрЗапуска, ";");
	Если Части.Количество() >= 3 И Части[0] = "Тесты" Тогда
		ВыполнитьНаСервере(Части[1], Части[2]);
	ИначеЕсли Части.Количество() >= 2 И Части[0] = "СнятьБезопасныйРежим" Тогда
		СнятьБезопасныйРежимНаСервере(Части[1]);
	ИначеЕсли Части.Количество() >= 2 И Части[0] = "Показать" Тогда
		// Для снимков: товары бухгалтера и загрузка из УНФ без отката, затем таблица с тем, что стало со справочником.
		ПодготовитьПоказНаСервере(Части[1]).Показать("Номенклатура после загрузки из УНФ");
		Отказ = Истина;
		Возврат;
	Иначе
		Возврат;
	КонецЕсли;
	ПодключитьОбработчикОжидания("Завершить", 0.1, Истина);

КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере(Каталог, ПутьКОтчетуТестов)

	Попытка
		РеквизитФормыВЗначение("Объект").ВыполнитьВсе(Каталог, ПутьКОтчетуТестов);
	Исключение
		// Ошибка компиляции модуля тестов тоже должна попасть в отчёт, а не в окно.
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст("СБОЙ ЗАПУСКА ТЕСТОВ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Текст.Записать(ПутьКОтчетуТестов, КодировкаТекста.UTF8);
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция ПодготовитьПоказНаСервере(Каталог)

	Возврат РеквизитФормыВЗначение("Объект").ПодготовитьПоказ(Каталог);

КонецФункции

&НаСервере
Процедура СнятьБезопасныйРежимНаСервере(ПутьКОтчету)

	РеквизитФормыВЗначение("Объект").СнятьБезопасныйРежим(ПутьКОтчету);

КонецПроцедуры

&НаКлиенте
Процедура Завершить() Экспорт

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры
